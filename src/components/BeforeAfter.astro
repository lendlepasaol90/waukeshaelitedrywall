---
/**
 * Before / after comparison slider.
 * A native range input sits over the images, so it is draggable, touch
 * friendly (vertical page scroll still works) and operable with arrow keys.
 */
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';
interface Props { before: string; after: string; beforeAlt: string; afterAlt: string; id: string; illustrative?: boolean }
const { before, after, beforeAlt, afterAlt, id, illustrative = true } = Astro.props;
const sizes = '(min-width: 56rem) 55vw, 100vw';
---
<div>
  <div class="ba" data-ba>
    <Picture src={photo(after)} alt={`After: ${afterAlt}`} widths={[640, 960, 1400]} sizes={sizes} formats={['avif', 'webp']} loading="lazy" />
    <Picture src={photo(before)} alt={`Before: ${beforeAlt}`} widths={[640, 960, 1400]} sizes={sizes} formats={['avif', 'webp']} loading="lazy" class="ba-before" />
    <span class="tag b" aria-hidden="true">Before</span>
    <span class="tag a" aria-hidden="true">After</span>
    <span class="handle" aria-hidden="true"></span>
    <label class="visually-hidden" for={id}>Drag or use the arrow keys to compare before and after</label>
    <input id={id} type="range" min="0" max="100" value="50" step="1" aria-valuetext="50% before, 50% after" />
  </div>
  {illustrative && (
    <p class="ba-note">Stock photos used to illustrate the change. Not a specific project of ours.</p>
  )}
</div>
